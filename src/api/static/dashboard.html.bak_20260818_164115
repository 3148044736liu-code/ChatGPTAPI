<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>GPT-FastAPI 运行中心</title>
  <style>
    :root {
      --bg: #071019;
      --panel: #0d1924;
      --panel-2: #111f2c;
      --line: rgba(159, 184, 203, .16);
      --text: #edf6fc;
      --muted: #8ca2b4;
      --cyan: #42d5db;
      --cyan-soft: rgba(66, 213, 219, .12);
      --green: #67dfa7;
      --yellow: #ffc766;
      --red: #ff7d83;
      --blue: #7aa8ff;
      --shadow: 0 20px 60px rgba(0, 0, 0, .28);
    }
    * { box-sizing: border-box; }
    html { background: var(--bg); }
    body {
      margin: 0;
      min-height: 100vh;
      color: var(--text);
      background:
        radial-gradient(circle at 15% -10%, rgba(30, 151, 165, .22), transparent 36%),
        radial-gradient(circle at 95% 12%, rgba(48, 77, 145, .18), transparent 34%),
        var(--bg);
      font-family: Inter, "Segoe UI", "Microsoft YaHei", system-ui, sans-serif;
      letter-spacing: .01em;
    }
    button, input, select { font: inherit; }
    a { color: inherit; text-decoration: none; }
    .shell { width: min(1500px, calc(100% - 40px)); margin: 0 auto; padding: 26px 0 54px; }
    .topbar { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-bottom: 24px; }
    .brand { display: flex; align-items: center; gap: 14px; }
    .brand-mark {
      width: 42px; height: 42px; border-radius: 13px; display: grid; place-items: center;
      background: linear-gradient(145deg, var(--cyan), #268fa7); color: #031217;
      font-weight: 900; box-shadow: 0 8px 30px rgba(66, 213, 219, .25);
    }
    .brand h1 { font-size: 18px; line-height: 1.1; margin: 0 0 5px; }
    .brand p { margin: 0; color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .14em; }
    .top-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
    .status-pill, .btn {
      height: 38px; padding: 0 14px; border-radius: 10px; border: 1px solid var(--line);
      background: rgba(12, 27, 39, .72); color: var(--text); display: inline-flex;
      align-items: center; gap: 8px; font-size: 13px;
    }
    .btn { cursor: pointer; transition: .18s ease; }
    .btn:hover { border-color: rgba(66, 213, 219, .45); background: var(--cyan-soft); transform: translateY(-1px); }
    .btn:disabled { opacity: .42; cursor: not-allowed; transform: none; }
    .btn-start { border-color: rgba(103,223,167,.35); color: var(--green); }
    .btn-stop, .btn-danger { border-color: rgba(255,125,131,.32); color: var(--red); }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--muted); box-shadow: 0 0 0 4px rgba(140, 162, 180, .08); }
    .dot.ok { background: var(--green); box-shadow: 0 0 0 4px rgba(103, 223, 167, .10), 0 0 18px rgba(103, 223, 167, .55); }
    .dot.warn { background: var(--yellow); }
    .hero {
      position: relative; overflow: hidden; padding: 28px; margin-bottom: 18px;
      border: 1px solid var(--line); border-radius: 20px; background: linear-gradient(125deg, rgba(17, 36, 49, .96), rgba(10, 23, 34, .92));
      box-shadow: var(--shadow); display: grid; grid-template-columns: 1.5fr 1fr; gap: 28px; align-items: end;
    }
    .hero:after { content: ""; position: absolute; width: 280px; height: 280px; right: -90px; top: -160px; border: 1px solid rgba(66, 213, 219, .22); border-radius: 50%; box-shadow: 0 0 0 34px rgba(66, 213, 219, .025), 0 0 0 68px rgba(66, 213, 219, .018); }
    .eyebrow { color: var(--cyan); font-size: 12px; text-transform: uppercase; letter-spacing: .16em; font-weight: 700; }
    .hero h2 { margin: 9px 0 11px; max-width: 820px; font-size: clamp(28px, 4vw, 48px); line-height: 1.08; letter-spacing: -.035em; }
    .hero-copy { margin: 0; max-width: 680px; color: #a9bdcb; line-height: 1.75; font-size: 14px; }
    .endpoint { position: relative; z-index: 1; padding: 17px 18px; border-radius: 14px; border: 1px solid rgba(66, 213, 219, .18); background: rgba(3, 16, 24, .62); }
    .endpoint small { display: block; color: var(--muted); margin-bottom: 8px; }
    .endpoint code { color: var(--cyan); word-break: break-all; font-family: "Cascadia Code", Consolas, monospace; font-size: 14px; }
    .grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 14px; }
    .card { border: 1px solid var(--line); border-radius: 16px; background: rgba(13, 25, 36, .88); box-shadow: 0 10px 35px rgba(0,0,0,.16); }
    .metric { grid-column: span 3; padding: 19px; min-height: 130px; position: relative; overflow: hidden; }
    .metric:before { content: ""; position: absolute; left: 0; top: 0; width: 3px; height: 100%; background: var(--accent, var(--cyan)); }
    .metric-label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .11em; }
    .metric-value { margin: 14px 0 8px; font-size: 31px; font-weight: 760; letter-spacing: -.04em; }
    .metric-note { color: #91a7b7; font-size: 12px; }
    .section { margin-top: 14px; }
    .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; padding: 18px 20px 13px; }
    .section-head h3 { margin: 0; font-size: 16px; }
    .section-head p { margin: 5px 0 0; color: var(--muted); font-size: 12px; }
    .tag { border: 1px solid var(--line); border-radius: 99px; padding: 5px 9px; color: var(--muted); font-size: 11px; }
    .clients { grid-column: span 8; overflow: hidden; }
    .side { grid-column: span 4; padding-bottom: 16px; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; min-width: 820px; }
    th { padding: 11px 16px; color: #7990a2; font-size: 11px; text-transform: uppercase; letter-spacing: .08em; text-align: left; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); font-weight: 650; }
    td { padding: 13px 16px; border-bottom: 1px solid rgba(159, 184, 203, .09); color: #c9d8e2; font-size: 12px; vertical-align: middle; }
    tbody tr:hover { background: rgba(66, 213, 219, .035); }
    .machine { display: flex; align-items: center; gap: 10px; }
    .machine-icon { width: 31px; height: 31px; border-radius: 9px; display: grid; place-items: center; color: var(--cyan); background: var(--cyan-soft); border: 1px solid rgba(66, 213, 219, .16); font-weight: 800; }
    .machine-name { color: var(--text); font-weight: 650; margin-bottom: 3px; }
    .subtle { color: var(--muted); font-size: 11px; }
    .state { display: inline-flex; align-items: center; gap: 7px; }
    .method { font: 700 10px/1 "Cascadia Code", Consolas, monospace; padding: 5px 7px; border-radius: 6px; background: rgba(122,168,255,.12); color: var(--blue); }
    .endpoint-path { font-family: "Cascadia Code", Consolas, monospace; color: #b7c9d5; }
    .bar-list { padding: 4px 20px 2px; }
    .bar-row { margin: 13px 0; }
    .bar-meta { display: flex; justify-content: space-between; gap: 12px; font-size: 11px; margin-bottom: 7px; color: var(--muted); }
    .bar-track { height: 6px; border-radius: 99px; background: rgba(255,255,255,.055); overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 99px; background: linear-gradient(90deg, #218fa6, var(--cyan)); }
    .service-list { display: grid; gap: 0; padding: 2px 20px; }
    .service-row { display: flex; justify-content: space-between; gap: 16px; padding: 11px 0; border-bottom: 1px solid rgba(159,184,203,.08); font-size: 12px; }
    .service-row span:first-child { color: var(--muted); }
    .service-row strong { text-align: right; font-weight: 620; }
    .recent { grid-column: span 12; overflow: hidden; }
    .logs { grid-column: span 12; overflow: hidden; }
    .projects { grid-column: span 12; overflow: hidden; }
    .project-form { display: grid; grid-template-columns: 1.1fr 1fr 1.5fr auto auto; gap: 9px; padding: 0 20px 17px; }
    .field { height: 38px; min-width: 0; padding: 0 11px; border-radius: 9px; border: 1px solid var(--line); background: #08151f; color: var(--text); }
    .check { display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: 12px; white-space: nowrap; }
    .token-reveal { display: none; margin: 0 20px 18px; padding: 15px; border: 1px solid rgba(255,199,102,.35); border-radius: 11px; background: rgba(255,199,102,.07); }
    .token-reveal.show { display: block; }
    .token-reveal code { display: block; margin: 8px 0; color: var(--yellow); word-break: break-all; font: 12px/1.6 "Cascadia Code", Consolas, monospace; }
    .btn-small { height: 30px; padding: 0 9px; font-size: 11px; }
    .log-tools { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
    .log-select { height: 36px; max-width: 420px; padding: 0 11px; border-radius: 9px; border: 1px solid var(--line); background: #0a1721; color: var(--text); }
    .log-view { margin: 0; min-height: 180px; max-height: 520px; overflow: auto; padding: 18px 20px; border-top: 1px solid var(--line); background: #061019; color: #bad0dc; white-space: pre-wrap; word-break: break-all; font: 11px/1.65 "Cascadia Code", Consolas, monospace; }
    .log-error { color: #ff9aa0; }
    .log-warn { color: #ffd58a; }
    .empty { padding: 38px 20px; text-align: center; color: var(--muted); border-top: 1px solid var(--line); }
    .toast { position: fixed; right: 24px; bottom: 24px; z-index: 60; padding: 12px 15px; border-radius: 10px; border: 1px solid var(--line); background: #10202d; color: var(--text); opacity: 0; transform: translateY(10px); pointer-events: none; transition: .2s ease; font-size: 12px; box-shadow: var(--shadow); }
    .toast.show { opacity: 1; transform: translateY(0); }
    @media (max-width: 1050px) { .metric { grid-column: span 6; } .clients, .side { grid-column: span 12; } .hero { grid-template-columns: 1fr; } .project-form { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 680px) { .shell { width: min(100% - 24px, 1500px); padding-top: 16px; } .topbar { align-items: flex-start; } .top-actions .status-pill { display: none; } .hero { padding: 21px; } .metric { grid-column: span 12; min-height: 112px; } .section-head { align-items: flex-start; } }
  </style>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div class="brand"><div class="brand-mark">GF</div><div><h1>GPT-FastAPI 运行中心</h1><p>Browser Gateway Control Room</p></div></div>
      <div class="top-actions">
        <input class="field" id="adminToken" type="password" autocomplete="off" placeholder="管理员 Token">
        <button class="btn" id="saveAdminToken" type="button">认证</button>
        <div class="status-pill"><span class="dot" id="liveDot"></span><span id="liveText">正在连接</span></div>
        <button class="btn btn-start" id="startRuntime" type="button">启动项目</button>
        <button class="btn btn-stop" id="stopRuntime" type="button">停止项目</button>
        <a class="btn" href="/docs" target="_blank" rel="noreferrer">接口文档</a>
        <button class="btn" id="downloadGuide" type="button">下载开发说明书</button>
        <button class="btn" id="refreshBtn" type="button">立即刷新</button>
      </div>
    </header>

    <section class="hero">
      <div><div class="eyebrow">Local AI Infrastructure</div><h2>浏览器网关的实时运行视图</h2><p class="hero-copy">聚合服务健康、ChatGPT 浏览器、单 Worker 队列和调用任务机状态。统计仅记录调用元数据，不保存请求正文或 API Token。</p></div>
      <button class="endpoint btn" id="copyEndpoint" type="button"><span><small>OpenAI Base URL · 点击复制</small><code id="baseUrl">http://192.168.10.48:3061/v1</code></span></button>
    </section>

    <section class="grid" aria-label="关键指标">
      <article class="card metric" style="--accent:var(--green)"><div class="metric-label">服务状态</div><div class="metric-value" id="serviceValue">--</div><div class="metric-note" id="serviceNote">等待状态数据</div></article>
      <article class="card metric"><div class="metric-label">在线任务机</div><div class="metric-value" id="onlineClients">--</div><div class="metric-note" id="clientNote">本次启动累计 -- 台</div></article>
      <article class="card metric" style="--accent:var(--blue)"><div class="metric-label">API 调用</div><div class="metric-value" id="totalRequests">--</div><div class="metric-note" id="requestNote">当前活跃 -- 个请求</div></article>
      <article class="card metric" style="--accent:var(--yellow)"><div class="metric-label">单 Worker 队列</div><div class="metric-value" id="poolValue">--</div><div class="metric-note" id="poolNote">等待 Worker 状态</div></article>
    </section>

    <section class="grid section">
      <article class="card clients">
        <div class="section-head"><div><h3>调用任务机</h3><p>在线状态按最近 5 分钟内有调用判定；可通过 X-Task-Machine 和 X-Task-Name 标记。</p></div><span class="tag" id="machineTag">0 台</span></div>
        <div class="table-wrap"><table><thead><tr><th>任务机</th><th>状态</th><th>任务 / 用户</th><th>调用量</th><th>最近接口</th><th>最近活动</th></tr></thead><tbody id="clientsBody"></tbody></table><div class="empty" id="clientsEmpty">尚未记录到 API 调用任务机</div></div>
      </article>
      <aside class="card side">
        <div class="section-head"><div><h3>高频接口</h3><p>自本次服务启动以来</p></div></div>
        <div class="bar-list" id="endpointBars"></div>
        <div class="section-head"><div><h3>运行明细</h3></div></div>
        <div class="service-list" id="serviceList"></div>
      </aside>
      <article class="card recent">
        <div class="section-head"><div><h3>最近调用记录</h3><p>仅展示方法、路径、任务机、状态码和耗时。</p></div><span class="tag" id="updatedAt">--</span></div>
        <div class="table-wrap"><table><thead><tr><th>时间</th><th>任务机</th><th>方法</th><th>接口</th><th>状态</th><th>耗时</th></tr></thead><tbody id="recentBody"></tbody></table><div class="empty" id="recentEmpty">暂无调用记录</div></div>
      </article>
      <article class="card projects">
        <div class="section-head"><div><h3>项目授权 Token 生成台</h3><p>一个项目对应一个 Token；Token 由 Windows DPAPI 加密保存，可随时复制。多智能体项目必须为每个智能体创建独立 session_id。</p></div><span class="tag" id="projectTag">0 个项目</span></div>
        <form class="project-form" id="projectForm"><input class="field" id="projectName" placeholder="项目名称" required maxlength="120"><input class="field" id="projectId" placeholder="项目 ID（英文，可留空）" maxlength="80"><input class="field" id="projectDesc" placeholder="用途说明" maxlength="500"><label class="check"><input id="projectMultiAgent" type="checkbox">多智能体项目</label><button class="btn" type="submit">生成 Token</button></form>
        <div class="token-reveal" id="tokenReveal"><strong>Token 已从服务器加密保险箱读取，可再次复制：</strong><code id="tokenValue"></code><button class="btn btn-small" id="copyToken" type="button">复制 Token</button></div>
        <div class="table-wrap"><table><thead><tr><th>项目</th><th>模式</th><th>Token 标识</th><th>会话 / 消息</th><th>最近使用</th><th>状态 / 操作</th></tr></thead><tbody id="projectsBody"></tbody></table><div class="empty" id="projectsEmpty">尚未创建项目 Token</div></div>
      </article>
      <article class="card logs">
        <div class="section-head"><div><h3>服务日志</h3><p>日志按天自动划分，保留启动、请求、状态码、耗时和异常堆栈。</p></div><div class="log-tools"><select class="log-select" id="logFile" aria-label="日志文件"></select><button class="btn" id="refreshLogs" type="button">刷新日志</button></div></div>
        <pre class="log-view" id="logView">正在读取日志...</pre>
      </article>
    </section>
  </main>
  <div class="toast" id="toast"></div>

  <script>
    const $ = (id) => document.getElementById(id);
    let timer = null;
    let logsInitialized = false;
    let adminToken = sessionStorage.getItem('gptFastApiAdminToken') || '';
    const escapeHtml = (value='') => String(value).replace(/[&<>'"]/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[ch]));
    const fmtAgo = (seconds) => seconds < 5 ? '刚刚' : seconds < 60 ? `${seconds} 秒前` : seconds < 3600 ? `${Math.floor(seconds/60)} 分钟前` : `${Math.floor(seconds/3600)} 小时前`;
    const fmtDuration = (seconds) => { const s = Number(seconds || 0); if (s < 60) return `${s} 秒`; const h=Math.floor(s/3600), m=Math.floor((s%3600)/60); return h ? `${h} 小时 ${m} 分` : `${m} 分钟`; };
    const fmtBytes = (bytes) => { const n=Number(bytes||0); if(n<1024) return `${n} B`; if(n<1048576) return `${(n/1024).toFixed(1)} KB`; return `${(n/1048576).toFixed(1)} MB`; };
    const timeText = (iso) => iso ? new Date(iso).toLocaleString('zh-CN', {hour12:false}) : '--';
    async function copyText(value) {
      try { await navigator.clipboard.writeText(value); return true; }
      catch {
        const box=document.createElement('textarea'); box.value=value; box.style.position='fixed'; box.style.opacity='0'; document.body.appendChild(box); box.select();
        const copied=document.execCommand('copy'); box.remove(); return copied;
      }
    }
    function toast(text) { $('toast').textContent=text; $('toast').classList.add('show'); setTimeout(()=>$('toast').classList.remove('show'),1800); }
    function setLive(ok, text) { $('liveDot').className=`dot ${ok?'ok':'warn'}`; $('liveText').textContent=text; }
    const adminHeaders = (extra={}) => ({...extra, ...(adminToken?{'X-Admin-Token':adminToken}:{})});
    async function loadState() {
      try {
        const response = await fetch('/api/dashboard/state', {cache:'no-store',headers:adminHeaders()});
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const state = await response.json();
        render(state); setLive(true,'实时连接');
      } catch (error) {
        setLive(false,`连接中断 · ${error.message}`);
      }
    }
    async function loadLogs(keepSelection=true) {
      const current=keepSelection?$('logFile').value:'';
      const query=current?`?file=${encodeURIComponent(current)}&lines=250`:'?lines=250';
      try {
        const response=await fetch(`/api/dashboard/logs${query}`, {cache:'no-store',headers:adminHeaders()});
        if(!response.ok) throw new Error(`HTTP ${response.status}`);
        const data=await response.json();
        const selected=current||data.selected||'';
        $('logFile').innerHTML=(data.files||[]).map(item=>`<option value="${escapeHtml(item.name)}" ${item.name===selected?'selected':''}>${escapeHtml(item.name)} · ${fmtBytes(item.size)}</option>`).join('');
        $('logView').innerHTML=(data.lines||[]).length?(data.lines||[]).map(line=>`<span class="${line.includes('| ERROR')?'log-error':line.includes('| WARNING')?'log-warn':''}">${escapeHtml(line)}</span>`).join('\n'):'暂无日志内容';
        $('logView').scrollTop=$('logView').scrollHeight;
        logsInitialized=true;
      } catch(error) { $('logView').textContent=`日志读取失败：${error.message}`; }
    }
    async function loadProjects() {
      try {
        const response=await fetch('/api/dashboard/projects',{cache:'no-store',headers:adminHeaders()});
        if(!response.ok) throw new Error(`HTTP ${response.status}`);
        const data=await response.json(); renderProjects(data.data||[]);
      } catch(error) { toast(`项目列表加载失败：${error.message}`); }
    }
    function renderProjects(items) {
      $('projectTag').textContent=`${items.length} 个项目`;
      $('projectsEmpty').style.display=items.length?'none':'block';
      $('projectsBody').innerHTML=items.map(p=>`<tr><td><div class="machine-name">${escapeHtml(p.name)}</div><div class="subtle">${escapeHtml(p.project_id)} · ${escapeHtml(p.description||'无说明')}</div></td><td>${p.multi_agent?'多智能体':'单项目'}<div class="subtle">${p.multi_agent?'每个智能体独立 session':'每个对话独立 session'}</div></td><td><span class="endpoint-path">${escapeHtml(p.token_prefix)}••••</span> <button class="btn btn-small" onclick="copyProjectToken('${escapeHtml(p.project_id)}')" ${p.token_available?'':'disabled'}>${p.token_available?'复制':'需轮换'}</button></td><td>${p.session_count||0} / ${p.message_count||0}</td><td>${escapeHtml(timeText(p.last_used_at))}</td><td><span style="color:${p.enabled?'var(--green)':'var(--red)'}">${p.enabled?'启用':'停用'}</span> <button class="btn btn-small" onclick="toggleProject('${escapeHtml(p.project_id)}',${!p.enabled})">${p.enabled?'停用':'启用'}</button> <button class="btn btn-small" onclick="rotateProject('${escapeHtml(p.project_id)}')">轮换</button> <button class="btn btn-small btn-danger" onclick="deleteProject('${escapeHtml(p.project_id)}')">删除</button></td></tr>`).join('');
    }
    function revealToken(token) { $('tokenValue').textContent=token; $('tokenReveal').classList.add('show'); }
    async function apiJson(url, options={}) { const response=await fetch(url,{...options,headers:adminHeaders({'Content-Type':'application/json',...(options.headers||{})})}); const data=await response.json(); if(!response.ok) throw new Error(data.detail||data.error?.message||`HTTP ${response.status}`); return data; }
    async function downloadGuide() { try { const response=await fetch('/api/dashboard/developer-guide',{headers:adminHeaders()}); if(!response.ok) throw new Error(`HTTP ${response.status}`); const blob=await response.blob(); const link=document.createElement('a'); link.href=URL.createObjectURL(blob); link.download='GPT-FastAPI_Developer_Guide.md'; link.click(); URL.revokeObjectURL(link.href); } catch(error){toast(`下载失败：${error.message}`);} }
    async function toggleProject(id,enabled) { try { await apiJson(`/api/dashboard/projects/${encodeURIComponent(id)}`,{method:'PATCH',body:JSON.stringify({enabled})}); await loadProjects(); toast(enabled?'项目已启用':'项目已停用'); } catch(error){toast(error.message);} }
    async function rotateProject(id) { if(!confirm(`确定轮换 ${id} 的 Token？旧 Token 会立即失效。`)) return; try { const data=await apiJson(`/api/dashboard/projects/${encodeURIComponent(id)}/rotate`,{method:'POST'}); revealToken(data.token); await loadProjects(); toast('Token 已轮换'); } catch(error){toast(error.message);} }
    async function copyProjectToken(id) { try { const data=await apiJson(`/api/dashboard/projects/${encodeURIComponent(id)}/token`); revealToken(data.token); const copied=await copyText(data.token); toast(copied?'Token 已复制，可随时再次复制':'Token 已显示，请手动复制'); } catch(error){toast(error.message);} }
    async function deleteProject(id) { if(!confirm(`确定删除 ${id} 的 Token 授权？\n\n该 Token 会立即失效；历史会话和文件元数据保留，项目 ID 不可重新占用。`)) return; try { await apiJson(`/api/dashboard/projects/${encodeURIComponent(id)}`,{method:'DELETE'}); $('tokenReveal').classList.remove('show'); $('tokenValue').textContent=''; await loadProjects(); toast('Token 已删除并立即吊销'); } catch(error){toast(error.message);} }
    async function controlRuntime(action) {
      if(action==='stop'&&!confirm('确定停止项目？所有 ChatGPT 浏览器页面和 Worker 都会关闭；Dashboard 会继续运行，可随时重新启动。')) return;
      const start=$('startRuntime'), stop=$('stopRuntime'); start.disabled=true; stop.disabled=true;
      try { toast(action==='start'?'正在启动并打开浏览器…':'正在停止并关闭浏览器…'); await apiJson(`/api/dashboard/runtime/${action}`,{method:'POST'}); await loadState(); toast(action==='start'?'项目已启动，浏览器已打开':'项目已停止，浏览器已关闭'); }
      catch(error) { toast(error.message); await loadState(); }
    }
    function render(data) {
      const s=data.service, t=data.telemetry, p=data.pool, b=data.browser, f=data.foreground, st=data.storage, rt=data.runtime||{status:'error',desired_running:true};
      const healthy=s.status==='ok' && b.ready && rt.status==='running';
      const transitioning=rt.status==='starting'||rt.status==='stopping';
      const stopped=rt.status==='stopped'&&!rt.desired_running;
      $('serviceValue').textContent=healthy?'运行中':stopped?'已停止':transitioning?(rt.status==='starting'?'启动中':'停止中'):'需检查';
      $('serviceValue').style.color=healthy?'var(--green)':stopped?'var(--red)':'var(--yellow)';
      $('serviceNote').textContent=stopped?`运行层已停止 · Dashboard 正常 · ${s.hostname}`:`${s.provider.toUpperCase()} · ${s.logged_in?'已登录':'登录状态异常'} · ${s.hostname}`;
      $('startRuntime').disabled=rt.status==='running'||rt.status==='starting'||rt.status==='stopping';
      $('stopRuntime').disabled=rt.status==='stopped'||rt.status==='starting'||rt.status==='stopping';
      $('onlineClients').textContent=t.online_clients;
      $('clientNote').textContent=`本次启动累计 ${t.unique_clients} 台 · ${t.online_window_seconds/60} 分钟窗口`;
      $('totalRequests').textContent=t.total_requests.toLocaleString();
      $('requestNote').textContent=`当前活跃 ${t.active_requests} · 成功率 ${t.success_rate}%`;
      $('poolValue').textContent=`${Math.min(p.available,p.healthy??p.capacity)}/${p.capacity}`;
      $('poolNote').textContent=`可用 worker · ${p.healthy??p.capacity} 个页面存活 · ${p.busy} 个正在占用`;
      $('baseUrl').textContent=`${s.base_url}/v1`;
      $('machineTag').textContent=`${t.clients.length} 台`;
      renderClients(t.clients); renderRecent(t.recent_requests); renderEndpoints(t.top_endpoints);
      const foregroundOk=f.enabled && f.active && f.visible_windows>0 && f.topmost_enforced;
      const rows=[
        ['运行时长', fmtDuration(t.uptime_seconds)], ['运行层', rt.status], ['浏览器页面', `${b.page_count} 个页面`],
        ['浏览器前台', foregroundOk?'可见且置顶':'未确认置顶'], ['Chrome 进程', `${f.chrome_processes||0} 个`],
        ['项目 / 已启用', `${st.projects||0} / ${st.enabled_projects||0}`], ['会话 / 消息', `${st.sessions||0} / ${st.messages||0}`], ['文件存储', `${st.files||0} 个 · ${fmtBytes(st.file_bytes)}`],
        ['版本', `v${s.version}`]
      ];
      $('serviceList').innerHTML=rows.map(([k,v])=>`<div class="service-row"><span>${escapeHtml(k)}</span><strong>${escapeHtml(v)}</strong></div>`).join('');
      $('updatedAt').textContent=`更新 ${new Date().toLocaleTimeString('zh-CN',{hour12:false})}`;
    }
    function renderClients(items) {
      $('clientsEmpty').style.display=items.length?'none':'block';
      $('clientsBody').innerHTML=items.map((c,i)=>{
        const tasks=(c.task_names||[]).join('、')||'未标记任务'; const owners=(c.owners||[]).join('、')||'--';
        return `<tr><td><div class="machine"><div class="machine-icon">${i+1}</div><div><div class="machine-name">${escapeHtml(c.display_name)}</div><div class="subtle">${escapeHtml(c.ip_address)}</div></div></div></td><td><span class="state"><span class="dot ${c.online?'ok':''}"></span>${c.active_requests?`执行中 (${c.active_requests})`:c.online?'在线':'空闲'}</span></td><td><div>${escapeHtml(tasks)}</div><div class="subtle">用户：${escapeHtml(owners)}</div></td><td>${c.total_requests}<div class="subtle">失败 ${c.error_requests}</div></td><td><span class="method">${escapeHtml(c.last_method)}</span> <span class="endpoint-path">${escapeHtml(c.last_path)}</span></td><td>${fmtAgo(c.last_seen_seconds_ago)}<div class="subtle">${c.last_duration_ms??'--'} ms</div></td></tr>`;
      }).join('');
    }
    function renderRecent(items) {
      $('recentEmpty').style.display=items.length?'none':'block';
      $('recentBody').innerHTML=items.slice(0,30).map(r=>`<tr><td>${escapeHtml(timeText(r.timestamp))}</td><td>${escapeHtml(r.machine_name||r.ip_address)}<div class="subtle">${escapeHtml(r.task_name||r.owner||'--')}</div></td><td><span class="method">${escapeHtml(r.method)}</span></td><td class="endpoint-path">${escapeHtml(r.path)}</td><td style="color:${r.status<400?'var(--green)':'var(--red)'}">${r.status}</td><td>${r.duration_ms} ms</td></tr>`).join('');
    }
    function renderEndpoints(items) {
      const max=Math.max(1,...items.map(x=>x.count));
      $('endpointBars').innerHTML=items.length?items.slice(0,6).map(x=>`<div class="bar-row"><div class="bar-meta"><span class="endpoint-path">${escapeHtml(x.path)}</span><strong>${x.count}</strong></div><div class="bar-track"><div class="bar-fill" style="width:${Math.max(5,x.count/max*100)}%"></div></div></div>`).join(''):'<div class="empty">暂无接口统计</div>';
    }
    $('refreshBtn').addEventListener('click',()=>loadState());
    $('startRuntime').addEventListener('click',()=>controlRuntime('start'));
    $('stopRuntime').addEventListener('click',()=>controlRuntime('stop'));
    $('refreshLogs').addEventListener('click',()=>loadLogs(true));
    $('logFile').addEventListener('change',()=>loadLogs(true));
    $('copyEndpoint').addEventListener('click',async()=>toast(await copyText($('baseUrl').textContent)?'Base URL 已复制':'请手动复制地址'));
    $('copyToken').addEventListener('click',async()=>toast(await copyText($('tokenValue').textContent)?'Token 已复制':'请手动复制 Token'));
    $('adminToken').value=adminToken;
    $('saveAdminToken').addEventListener('click',()=>{adminToken=$('adminToken').value.trim(); if(adminToken){sessionStorage.setItem('gptFastApiAdminToken',adminToken);}else{sessionStorage.removeItem('gptFastApiAdminToken');} logsInitialized=false; loadState(); loadLogs(false); loadProjects(); toast(adminToken?'管理员认证已更新':'管理员认证已清除');});
    $('downloadGuide').addEventListener('click',downloadGuide);
    $('projectForm').addEventListener('submit',async(event)=>{event.preventDefault();try{const data=await apiJson('/api/dashboard/projects',{method:'POST',body:JSON.stringify({name:$('projectName').value,project_id:$('projectId').value||null,description:$('projectDesc').value,multi_agent:$('projectMultiAgent').checked})});revealToken(data.token);event.target.reset();await loadProjects();toast('项目 Token 已生成');}catch(error){toast(error.message);}});
    loadState();
    loadLogs(false);
    loadProjects();
    timer=setInterval(loadState,5000);
  </script>
</body>
</html>
