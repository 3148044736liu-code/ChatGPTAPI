# ──────────────────────────────────────────────────────────────
# CatGPT Gateway Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# All settings have sensible defaults. The only thing you
# probably want to change is PROVIDER and API_TOKEN.
# ──────────────────────────────────────────────────────────────

# ── Provider ──────────────────────────────────────────────────
# Which AI provider to use. Options: "chatgpt" or "claude"
PROVIDER=chatgpt

# ── Browser ──────────────────────────────────────────────────
# Directory where the browser profile (cookies, login session) is stored.
# Use a separate directory per provider so sessions don't conflict.
#   ChatGPT: ./browser_data
#   Claude:  ./browser_data_claude
BROWSER_DATA_DIR=./browser_data

# Run browser without a visible window. Not recommended because
# headless mode is easily detected by anti-bot systems.
HEADLESS=false

# Windows local runner: keep the ChatGPT Chrome window visible and always on
# top. The foreground heartbeat is displayed on /dashboard.
BROWSER_KEEP_FOREGROUND=false
BROWSER_FOREGROUND_STATE_FILE=data/browser_foreground_state.json

# Playwright slow-motion delay in ms. Useful for debugging.
# Set to 0 for normal speed.
SLOW_MO=50

# ── Provider URLs ────────────────────────────────────────────
# Base URLs for each provider. You shouldn't need to change these.
CHATGPT_URL=https://chatgpt.com
CLAUDE_URL=https://claude.ai

# ── Timeouts (milliseconds) ─────────────────────────────────
# Max time to wait for the model to finish responding.
RESPONSE_TIMEOUT=120000

# Timeout per DOM selector probe when looking for UI elements.
SELECTOR_TIMEOUT=10000

# ── Human Behavior Simulation ───────────────────────────────
# Randomized delays to make browser interaction look human.
# All values in milliseconds.
TYPING_SPEED_MIN=50
TYPING_SPEED_MAX=150
THINKING_PAUSE_MIN=1000
THINKING_PAUSE_MAX=3000

# ── Logging ──────────────────────────────────────────────────
# Directory for log files.
LOG_DIR=./logs

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG

# Daily log files older than this many days are deleted on rollover/startup.
LOG_RETENTION_DAYS=30

# Print logs to console in addition to log files.
VERBOSE=true

# ── API Server ───────────────────────────────────────────────
# Address and port the FastAPI server listens on.
API_HOST=192.168.8.222
API_PORT=5061

# Minimum seconds between API requests (rate limiting).
RATE_LIMIT_SECONDS=5

# Bearer token for API authentication.
# Include this in every request: Authorization: Bearer <token>
# Empty values lock business APIs with service_not_configured; auth cannot be disabled.
API_TOKEN=dummy123

# Optional per-user tokens: owner:token pairs separated by commas.
# API_USER_TOKENS=alice:replace-with-a-secret,bob:replace-with-a-secret
API_USER_TOKENS=

# Dedicated dashboard/admin credential. Keep it distinct from all project tokens.
ADMIN_TOKEN=replace-with-a-separate-strong-admin-token
# Optional one-time initializer accepted only while no project exists.
BOOTSTRAP_ADMIN_TOKEN=
# Set false only on a trusted private network to make /dashboard open directly.
DASHBOARD_REQUIRE_ADMIN_TOKEN=true
# Linux/macOS token-vault key (Fernet); Windows uses DPAPI.
TOKEN_VAULT_KEY=

# Concurrent HTTP submissions enter a bounded FIFO scheduler. One persistent
# browser page executes jobs serially with a random start-to-start gap.
MAX_CONCURRENT_SESSIONS=1
BROWSER_TASK_GAP_MIN_SECONDS=30
BROWSER_TASK_GAP_MAX_SECONDS=50
MAX_BROWSER_QUEUE_DEPTH=100
MAX_FILE_SIZE_MB=25
REMOTE_FILE_CONNECT_TIMEOUT_SECONDS=10
REMOTE_FILE_READ_TIMEOUT_SECONDS=30
FILE_TTL_HOURS=72
# Set a stable random secret before sharing signed download links.
DOWNLOAD_SECRET=change-this-download-signing-secret

# Per-owner disk quota for stored files (uploads + generated files), in MB.
# Uploading beyond this returns HTTP 507.
USER_FILE_QUOTA_MB=500
# Max number of live files allowed inside a single session. Extra uploads
# return HTTP 409.
MAX_FILES_PER_SESSION=20
# How often (minutes) the background task sweeps expired files.
FILE_CLEANUP_INTERVAL_MINUTES=10
# When true, /v1/chat/completions WITHOUT a session_id also goes through the
# managed session pool (auto-creating an ephemeral session). When false, only
# requests that explicitly pass session_id use the pool.
OPENAI_USE_SESSION_POOL=false

# Comma-separated browser origins allowed to call the API. Empty = same-origin only.
CORS_ALLOWED_ORIGINS=

# Dashboard data/actions require ADMIN_TOKEN unless the private-LAN switch is false.
# A task machine is considered online when it has called the API inside this
# window. Request bodies and tokens are never stored in dashboard telemetry.
DASHBOARD_ONLINE_WINDOW_SECONDS=300
DASHBOARD_MAX_RECENT_REQUESTS=200

# ── VNC (Docker only) ────────────────────────────────────────
# Password for the noVNC browser UI at http://localhost:6080
# Used to visually access the browser for login and debugging.
VNC_PASSWORD=catgpt
